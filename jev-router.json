{
  "enabled": true,
  "jev": {
    "provider": "openrouter",
    "endpoint": "https://openrouter.ai/api/alpha/decisions",
    "model": "~typesafe/jev-latest",
    "timeoutMs": 1800,
    "cacheSeconds": 300,
    "maxPromptChars": 2000,
    "minConfidence": 0.6,
    "decisionTtlMs": 45000
  },
  "providers": {
    "allow": [
      "openai-codex",
      "anthropic",
      "commandcode"
    ]
  },
  "targets": {
    "luna": {
      "models": [
        "openai-codex/gpt-6-luna"
      ],
      "thinking": "low"
    },
    "muse": {
      "models": [
        "commandcode/meta/muse-spark-1.3-contributor"
      ],
      "thinking": "low"
    },
    "sol": {
      "models": [
        "openai-codex/gpt-6-sol"
      ],
      "thinking": {
        "high": "high",
        "default": "medium"
      }
    },
    "deepseek": {
      "models": [
        "commandcode/deepseek/deepseek-v4.1-flash"
      ],
      "thinking": "low"
    },
    "opus": {
      "models": [
        "anthropic/claude-opus-5-5"
      ],
      "thinking": "medium"
    },
    "sonnet": {
      "models": [
        "anthropic/claude-sonnet-5"
      ],
      "thinking": "medium"
    }
  },
  "routes": [
    {
      "when": {
        "risk": [
          "high"
        ]
      },
      "target": "sol"
    },
    {
      "when": {
        "type": [
          "planning"
        ]
      },
      "target": "opus"
    },
    {
      "when": {
        "type": [
          "design"
        ]
      },
      "target": "sonnet"
    },
    {
      "when": {
        "complexity": [
          "trivial"
        ]
      },
      "target": "luna"
    },
    {
      "when": {
        "complexity": [
          "high"
        ]
      },
      "target": "opus"
    },
    {
      "when": {
        "type": [
          "review"
        ]
      },
      "target": "sol"
    },
    {
      "when": {
        "type": [
          "coding",
          "operations"
        ],
        "risk": [
          "medium"
        ]
      },
      "target": "sol"
    },
    {
      "when": {
        "type": [
          "research"
        ]
      },
      "target": "deepseek"
    },
    {
      "when": {
        "type": [
          "operations"
        ],
        "complexity": [
          "medium"
        ]
      },
      "target": "deepseek"
    },
    {
      "target": "muse"
    }
  ],
  "safety": {
    "enabled": true,
    "mode": "shadow",
    "tools": [
      "bash",
      "write",
      "edit",
      "ast_edit"
    ],
    "jev": {
      "enabled": false,
      "tools": [
        "bash"
      ],
      "timeoutMs": 600,
      "cacheSeconds": 300,
      "maxActionChars": 600,
      "minConfidence": 0.75,
      "askInHeadless": "warn"
    }
  },
  "verify": {
    "enabled": false,
    "minConfidence": 0.8,
    "maxContinuations": 1,
    "maxAnswerChars": 2000,
    "skipTrivial": true
  },
  "cascade": {
    "enabled": false,
    "minConfidence": 0.7,
    "targets": {
      "easy": "deepseek",
      "medium": "muse",
      "hard": "opus"
    },
    "maxTaskChars": 1200
  },
  "economy": {
    "stickyFollowUps": true,
    "followUpMaxChars": 120,
    "respectManualModel": true
  },
  "logging": {
    "enabled": true,
    "path": "jev-evals.jsonl"
  }
}
