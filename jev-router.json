{
  "enabled": true,
  "jev": {
    "provider": "openrouter",
    "endpoint": "https://openrouter.ai/api/alpha/decisions",
    "model": "~typesafe/jev-latest",
    "timeoutMs": 1800,
    "cacheSeconds": 300,
    "maxPromptChars": 2000
  },
  "safety": {
    "enabled": true,
    "mode": "shadow",
    "tools": [
      "bash",
      "write",
      "edit",
      "ast_edit"
    ],
    "jev": {
      "enabled": false,
      "tools": [
        "bash"
      ],
      "timeoutMs": 600,
      "cacheSeconds": 300,
      "maxActionChars": 600,
      "minConfidence": 0.75,
      "askInHeadless": "warn"
    }
  },
  "verify": {
    "enabled": false,
    "minConfidence": 0.8,
    "maxContinuations": 1,
    "maxAnswerChars": 2000
  },
  "logging": {
    "enabled": true,
    "path": "jev-evals.jsonl"
  }
}
